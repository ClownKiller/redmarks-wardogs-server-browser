{
  "name": "redmarks-wardogs-server-browser",
  "productName": "RedMarks Wardogs Server Browser",
  "version": "1.2.1",
  "description": "Standalone server browser for WARDOGS. Reads public data from wardogserverlist.com. Never touches the game.",
  "main": "src/main/main.js",
  "author": "RedMarks",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/ClownKiller/redmarks-wardogs-server-browser",
  "scripts": {
    "assets": "node scripts/copy-assets.js",
    "start": "node scripts/copy-assets.js && electron .",
    "test": "node --test test/core.test.js",
    "dist": "node scripts/copy-assets.js && electron-builder --win --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/saira-stencil-one": "5.3.0",
    "@tabler/icons-webfont": "3.46.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.redmarks.wardogsserverbrowser",
    "productName": "RedMarks Wardogs Server Browser",
    "copyright": "RedMarks",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RedMarks-Wardogs-Server-Browser-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RedMarks Wardogs Server Browser",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "npmRebuild": false
  }
}
